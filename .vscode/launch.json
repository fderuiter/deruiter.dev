{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Fullstack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Vitest: Debug Current Test File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--no-install", "vitest", "run", "${relativeFile}"],
      "env": {
        "DATABASE_URL": "postgresql://dummy:dummy@127.0.0.1:59999/dummy"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Playwright: Debug Synthetic Probes",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--no-install",
        "playwright",
        "test",
        "__tests__/e2e/synthetic-probes.spec.ts",
        "--project=chromium",
        "--debug"
      ],
      "env": {
        "DATABASE_URL": "postgresql://dummy:dummy@127.0.0.1:59999/dummy"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "DX: Run Doctor Diagnostics",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dx doctor",
      "env": {
        "DATABASE_URL": "postgresql://dummy:dummy@127.0.0.1:59999/dummy"
      }
    }
  ]
}
