{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "typescript",
          "source": "ts",
          "applyTo": "closedDocuments",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^\\[tsc\\]\\s+([^\\s].*?)(?:\\(|:)(\\d+)(?:,|:)(\\d+)(?:\\):|\\s+-)\\s+(error|warning|info)\\s+TS(\\d+)\\s*:\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": {
              "regexp": "^\\[tsc\\]\\s+.*(?:Starting compilation in watch mode|File change detected\\. Starting incremental compilation)\\.\\.\\."
            },
            "endsPattern": {
              "regexp": "^\\[tsc\\]\\s+.*Found \\d+ errors?\\. Watching for file changes\\."
            }
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: dev"
    },
    {
      "type": "npm",
      "script": "quality",
      "group": "test",
      "problemMatcher": [],
      "label": "npm: quality"
    },
    {
      "type": "npm",
      "script": "verify",
      "group": "test",
      "problemMatcher": [],
      "label": "npm: verify"
    },
    {
      "type": "npm",
      "script": "doctor:fix",
      "problemMatcher": [],
      "label": "npm: doctor:fix"
    }
  ]
}
