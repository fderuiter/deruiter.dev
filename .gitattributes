# Keep LF line endings in every checkout, including Windows editors that
# touch a WSL clone; tests pin content hashes and compare generated output (#939).
* text=auto eol=lf

# Vendored third-party files keep their upstream bytes, CRLF included, so
# the SHA-256 recorded in each SOURCE.md matches the checkout.
__tests__/fixtures/schemas/dataset-json-1.1/dataset.schema.json -text
__tests__/fixtures/schemas/dataset-json-1.1/LICENSE -text
__tests__/fixtures/schemas/define-xml-2.1/** -text
__tests__/fixtures/schemas/odcs-3.2.0/odcs-json-schema-v3.2.0.json -text
__tests__/fixtures/schemas/odcs-3.2.0/LICENSE -text
__tests__/fixtures/schemas/openlineage-1.54.0/*.json -text
__tests__/fixtures/schemas/openlineage-1.54.0/LICENSE -text
__tests__/fixtures/schemas/ars-1.0/ars_ldm.schema.json -text
__tests__/fixtures/schemas/ars-1.0/LICENSE -text

# Binary assets must never undergo text/EOL normalization or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.psd binary
*.ai binary
*.eps binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.ogg binary
*.pdf binary
*.zip binary
