// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CaseStudy {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  title                   String
  primary_language        String
  github_url              String?
  editorial_content       String   // Stores general descriptions
  architectural_narrative String   // Stores deep-dive technical explanations
  published               Boolean  @default(false)
  simulated_telemetry     Boolean  @default(false)
  tags                    String   // Comma-separated string or a related Tag model
  commands_json           String?
  playback_json           String?
  hero_image_url          String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@index([published, created_at])
}

model BlogPost {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  dek                  String   // Short standfirst/summary shown on the /blog index grid
  body                 String   // Sanitized HTML — same allowlist as CaseStudy.architectural_narrative
  pillar               String   // One of ADR 0041's content-pillar taxonomy
  tags                 String   // Comma-separated string, same convention as CaseStudy.tags
  published            Boolean  @default(false)
  reading_time_minutes Int?
  hero_image_url       String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  newsletterDispatch   NewsletterDispatch?

  @@index([published, created_at])
  @@index([published, updated_at])
}

model TelemetryEvent {
  id          String   @id @default(cuid())
  projectSlug String
  eventType   String   // "page_view" | "project_click"
  createdAt   DateTime @default(now())

  @@index([projectSlug])
  @@index([eventType])
  @@index([createdAt])
}

model TelemetryDailyRollup {
  day         DateTime @db.Date
  projectSlug String
  eventType   String
  count       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([day, projectSlug, eventType])
  @@index([day])
}

model CaseStudyFeedback {
  id             String   @id @default(cuid())
  caseStudySlug  String
  takeaways      String
  comments       String
  connectionHash String
  createdAt      DateTime @default(now())

  @@index([caseStudySlug])
  @@index([connectionHash])
  @@index([caseStudySlug, createdAt])
  @@index([caseStudySlug, connectionHash, createdAt])
}

model CaseStudyReaction {
  id             String   @id @default(cuid())
  caseStudySlug  String
  reactionType   String
  connectionHash String
  createdAt      DateTime @default(now())

  @@unique([caseStudySlug, reactionType, connectionHash])
  @@index([caseStudySlug])
  @@index([caseStudySlug, reactionType])
  @@index([connectionHash])
}

model BlogPostReaction {
  id             String   @id @default(cuid())
  blogPostSlug   String
  reactionType   String
  connectionHash String
  createdAt      DateTime @default(now())

  @@unique([blogPostSlug, reactionType, connectionHash])
  @@index([blogPostSlug])
  @@index([blogPostSlug, reactionType])
  @@index([connectionHash])
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

enum OutboundEmailStatus {
  PENDING
  RETRYING
  DELIVERED
  FAILED
}

model SuppressionList {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

model OutboundEmailQueue {
  id          String              @id @default(cuid())
  to          String
  from        String
  replyTo     String?
  subject     String
  html        String              @db.Text
  text        String?             @db.Text
  tags        Json?
  attempts    Int                 @default(0)
  status      OutboundEmailStatus @default(PENDING)
  nextRetryAt DateTime            @default(now())
  lastError   String?             @db.Text
  /// Extra RFC 5322 headers (e.g. List-Unsubscribe) replayed on every attempt.
  headers     Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([createdAt])
}

enum NewsletterSubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

/// A Systems Dispatch subscriber. Double opt-in: only CONFIRMED rows ever
/// receive a dispatch (#841).
model NewsletterSubscriber {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  status             NewsletterSubscriberStatus @default(PENDING)
  /// Single-use; cleared once the address is confirmed.
  confirmationToken  String?                    @unique
  confirmationSentAt DateTime?
  /// Long-lived; every dispatch carries it in its one-click unsubscribe link.
  unsubscribeToken   String                     @unique
  confirmedAt        DateTime?
  unsubscribedAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deliveries         NewsletterDelivery[]

  @@index([status])
}

/// One announcement of a newly published blog post, drained across daily
/// maintenance runs under the dispatch cap.
model NewsletterDispatch {
  id          String               @id @default(cuid())
  blogPostId  String               @unique
  blogPost    BlogPost             @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  deliveries  NewsletterDelivery[]

  @@index([completedAt])
}

/// Records that a dispatch was queued for a subscriber, so no one is sent the
/// same announcement twice.
model NewsletterDelivery {
  id           String               @id @default(cuid())
  dispatchId   String
  dispatch     NewsletterDispatch   @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  queueId      String?
  createdAt    DateTime             @default(now())

  @@unique([dispatchId, subscriberId])
  @@index([subscriberId])
}
