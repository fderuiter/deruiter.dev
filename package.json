{
  "name": "fderuiter-portfolio",
  "version": "0.4.0",
  "private": true,
  "description": "Interactive systems-engineering portfolio and browser-based technical studios.",
  "homepage": "https://deruiter.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fderuiter/deruiter.dev.git"
  },
  "bugs": {
    "url": "https://github.com/fderuiter/deruiter.dev/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dx": "tsx scripts/dx.ts",
    "crf": "tsx scripts/crf.ts",
    "study": "tsx scripts/study.ts",
    "setup": "tsx scripts/dx.ts setup",
    "setup:clerk": "./scripts/setup-clerk-wizard.sh",
    "bootstrap": "bash scripts/setup.sh",
    "doctor": "tsx scripts/dx.ts doctor",
    "doctor:fix": "tsx scripts/dx.ts doctor --fix",
    "verify": "tsx scripts/dx.ts verify",
    "commit": "tsx scripts/dx.ts commit",
    "env:check": "tsx scripts/dx.ts env",
    "preflight": "tsx scripts/dx.ts preflight",
    "dead-code": "tsx scripts/dx.ts dead-code",
    "dx:issues:sync": "tsx scripts/sync-issues.ts",
    "analyze:bundle": "tsx scripts/dx.ts analyze",
    "bench": "tsx scripts/dx.ts bench",
    "bench:pages": "tsx scripts/benchmark-pages.ts",
    "bench:crf": "tsx --expose-gc scripts/benchmark-crf.ts",
    "scaffold": "tsx scripts/dx.ts scaffold",
    "quality": "npm run check && npm run lint:docs && npm run check-docs-drift && npm run audit:licenses && npm run audit:secrets && npm run audit:a11y && npm run bench:pages -- --assert && npm run verify",
    "predev": "tsx scripts/generate-theme.ts",
    "dev": "concurrently -n \"turbo,tsc\" -c \"cyan,magenta\" \"next dev --turbo\" \"node node_modules/@typescript/native/bin/tsc --noEmit --watch --checkers 2\"",
    "build:icons": "tsx scripts/generate-brand-icons.ts",
    "build:theme": "tsx scripts/generate-theme.ts",
    "generate:icons": "tsx scripts/generate-brand-icons.ts",
    "generate:theme": "tsx scripts/generate-theme.ts",
    "precompile-docs": "prisma generate",
    "compile-docs": "tsx scripts/compile-docs.ts && npm run generate:llms",
    "generate:llms": "tsx scripts/generate-llms-txt.ts",
    "check-docs-drift": "tsx scripts/check-drift.ts",
    "check:migrations": "node scripts/check-migrations.js",
    "check:migration-safety": "tsx scripts/check-migration-safety.ts",
    "check:migrations:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "migration:replay": "tsx scripts/migration-replay.ts",
    "verify:upstash": "tsx scripts/verify-upstash.ts",
    "inventory:vercel": "tsx scripts/vercel-retention-inventory.ts",
    "inventory:neon": "tsx scripts/neon-capacity-inventory.ts",
    "headroom:vercel": "tsx scripts/vercel-headroom.ts",
    "lint:docs": "markdownlint \"**/*.md\" --ignore node_modules --ignore .next --ignore coverage --ignore .agents --ignore scratch --ignore tmp --ignore test-results --ignore playwright-report",
    "prebuild": "tsx scripts/generate-theme.ts && tsx scripts/generate-llms-txt.ts",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "eslint --no-warn-ignored --max-warnings=0",
    "lint:boundaries": "depcruise lib app components __tests__ hooks scripts",
    "pretypecheck": "prisma generate",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit --checkers 2",
    "typecheck:budget": "next typegen && tsx scripts/typecheck-budget.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries",
    "prepare": "husky",
    "preinstall": "node scripts/enforce-npm.js",
    "postinstall": "prisma generate",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:staged": "tsx scripts/test-staged.ts",
    "test:ci": "vitest run --coverage",
    "test:ci:shard": "VITEST_COVERAGE_THRESHOLDS=deferred-to-merge vitest run --coverage --reporter=blob --reporter=github-actions --reporter=dot",
    "test:ci:merge": "vitest --merge-reports --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:fuzz": "vitest run __tests__/property-fuzz.test.ts",
    "test:mutation": "tsx scripts/run-mutation-tests.ts",
    "test:e2e:phone": "playwright test --project=\"Phone*\"",
    "audit:a11y": "playwright test __tests__/e2e/accessibility.spec.ts --project=chromium",
    "audit:licenses": "tsx scripts/license-audit.ts",
    "oss:credits": "tsx scripts/oss-credits.ts",
    "deps:fix": "tsx scripts/deps-fix.ts",
    "audit:security": "tsx scripts/security-audit.ts",
    "audit:secrets": "tsx scripts/audit-secret-history.ts",
    "audit:triage": "tsx scripts/triage-security-issue.ts",
    "probe:synthetic": "playwright test __tests__/e2e/synthetic-probes.spec.ts",
    "canary:eval": "tsx scripts/canary-analyzer.ts"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "@serwist/next": {
      "zod": "$zod",
      "glob": "^14.0.2"
    },
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    },
    "typed-rest-client": {
      "qs": "^6.16.1"
    },
    "isomorphic-dompurify": {
      "jsdom": "26.1.0"
    },
    "micromark-extension-math": {
      "katex": "^0.18.11"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "markdownlint-cli": {
      "js-yaml": "~5.4.3",
      "minimatch": "^11.0.1",
      "smol-toml": "^1.9.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@clerk/nextjs": "^7.9.20",
    "@clerk/themes": "^2.4.57",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/fiber": "^9.8.2",
    "@sentry/nextjs": "^11.9.0",
    "@serwist/next": "^9.5.13",
    "@serwist/sw": "^9.5.13",
    "@tabler/icons-react": "^3.49.0",
    "@types/three": "^0.186.0",
    "@upstash/qstash": "^2.12.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "apache-arrow": "17.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.14.0",
    "framer-motion": "^13.5.1",
    "isomorphic-dompurify": "^4.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@playwright/test": "^1.64.1",
    "@react-three/test-renderer": "^9.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "8.20.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "xmllint-wasm": "5.3.0"
  },
  "allowScripts": {
    "@clerk/shared": true,
    "@prisma/engines": true,
    "core-js": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "prisma": {
    "seed": "npx --no-install tsx prisma/seed.ts"
  },
  "browserslist": [
    "defaults and > 0.5%",
    "not IE 11",
    "not dead"
  ]
}
