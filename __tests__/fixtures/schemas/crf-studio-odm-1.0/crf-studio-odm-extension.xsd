<?xml version="1.0" encoding="UTF-8"?>
<!--
  CRF Studio ODM vendor extension (#3022): ODM 1.3.2 with the design audit
  trail allowed at the end of MetaDataVersion. Built the way Define-XML 2.1
  extends ODM (define-extension.xsd): a redefine of the ODM foundation
  schema, whose extension groups are empty sequences.
-->
<xs:schema xmlns="http://www.cdisc.org/ns/odm/v1.3"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:crfs="https://deruiter.dev/ns/crf-studio/v1"
           targetNamespace="http://www.cdisc.org/ns/odm/v1.3"
           elementFormDefault="qualified" attributeFormDefault="unqualified"
           version="1.0">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="../core/xml.xsd"/>
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="../core/xmldsig-core-schema.xsd"/>
  <xs:import namespace="https://deruiter.dev/ns/crf-studio/v1" schemaLocation="crf-studio-ns.xsd"/>
  <xs:redefine schemaLocation="../cdisc-odm-1.3.2/ODM1-3-2-foundation.xsd">
    <xs:group name="MetaDataVersionElementExtension">
      <xs:sequence>
        <xs:group ref="MetaDataVersionElementExtension"/>
        <xs:element ref="crfs:AuditTrail" minOccurs="0"/>
      </xs:sequence>
    </xs:group>
  </xs:redefine>
</xs:schema>
