{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deruiter.dev/schemas/license-policy.schema.json",
  "title": "Lockfile License Compliance Policy",
  "description": "Allow-list of SPDX license identifiers and time-bounded dependency license exceptions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "allowedLicenses", "exceptions"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./license-policy.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "allowedLicenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageName",
          "license",
          "createdAt",
          "expiresAt",
          "riskOwner",
          "ticket",
          "rationale"
        ],
        "properties": {
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 calendar date (YYYY-MM-DD) when the exception was created or renewed."
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 calendar date (YYYY-MM-DD), at most 90 days after createdAt."
          },
          "riskOwner": {
            "type": "string",
            "pattern": "^@?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$",
            "description": "GitHub handle of the responsible risk owner."
          },
          "ticket": {
            "type": "string",
            "pattern": "^#[1-9]\\d*$",
            "description": "GitHub issue reference (#NNNN) tracking the exception."
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
