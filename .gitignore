# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.stryker-tmp
# Stryker's incremental report lives in /reports (#1772)
/reports
# Vitest and Playwright shard blobs (#1770, #1775)
/.vitest-reports
/blob-report
# ESLint cache (CI restores it in the static gate, #1768)
.eslintcache

# next.js
/.next/
/out/
/public/sw.js
/public/sw.js.map

# production
/build
/.benchmark-results/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# setup progress (stage outcomes only, never values; scripts/setup.sh)
/.setup-state.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
*.db
*.db-journal
*.log
app/theme.css
/.scratch
/scratch/
/.jules/
/tmp/

# clerk configuration (can include secrets)
/.clerk/

# local media storage persistence
/.media-storage/
.env*.local
