# Vercel builds from source on its own runners, so local build output, installed
# dependencies and agent scratch space must never be uploaded. Without this file
# a deploy uploads ~200,000 files instead of the ~3,200 tracked in git, which
# exhausts the free tier's 5,000-request daily upload allowance and locks
# deployments out for 24 hours.

# Local build output and generated runtime clients. Vercel warns explicitly not
# to upload these; postinstall and build regenerate them on the runner.
.next
out
build
.vercel
app/generated/prisma
docs/reference/api

# Installed dependencies and local R libraries. Reinstalled from lockfiles.
node_modules
scripts/r/renv/library

# Agent worktrees and scratchpads. Worktrees are full second checkouts of this
# repository, each with its own node_modules and .next (see #849).
.agents
.claude
.jules
.scratch
scratch
tmp

# Test, mutation, benchmark, and linter caches/output.
coverage
test-results
playwright-report
.nyc_output
.stryker-tmp
reports
.vitest
blob-report
.benchmark-results
.eslintcache
.prettiercache

# Local environment, certificates, databases, state, and logs. Secrets must
# never leave the machine; .env.example stays included for schema parity.
.env*
!.env.example
*.pem
.clerk
.media-storage
.setup-state.json
.DS_Store
*.tsbuildinfo
*.db
*.db-journal
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Version control metadata.
.git
.github
.husky/_
