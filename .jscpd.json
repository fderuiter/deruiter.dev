{
  "threshold": 0,
  "minTokens": 50,
  "minLines": 5,
  "path": [
    "app",
    "components",
    "hooks",
    "lib",
    "prisma",
    "scripts"
  ],
  "ignore": [
    "**/.next/**",
    "**/.vercel/**",
    "**/.claude/**",
    "**/.stryker-tmp/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/*.d.ts",
    "app/generated/**",
    "**/app/generated/**"
  ],
  "reporters": [
    "console"
  ],
  "format": [
    "typescript",
    "javascript",
    "jsx",
    "tsx"
  ]
}
